{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "SkillFile": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "default": false,
          "type": "boolean"
        },
        "path": {
          "default": "",
          "type": "string"
        },
        "size": {
          "default": 0,
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "SkillLimits": {
      "additionalProperties": false,
      "properties": {
        "bundleBytes": {
          "default": 16777216,
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "fileBytes": {
          "default": 4194304,
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "default": 500,
          "format": "uint32",
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "uploadBytes": {
          "default": 5242880,
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "SkillSource": {
      "additionalProperties": false,
      "properties": {
        "folder": {
          "default": "",
          "type": "string"
        },
        "importedAt": {
          "default": 0,
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "instance": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "location": {
          "additionalProperties": true,
          "description": "Validated against the selected package's manifest, never used for Cairn policy.",
          "type": "object",
          "x-cairn-json-object": true
        },
        "modified": {
          "default": false,
          "type": "boolean"
        },
        "pluginId": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "location"
      ],
      "type": "object"
    }
  },
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "default": [],
      "items": {
        "$ref": "#/definitions/SkillFile"
      },
      "type": "array"
    },
    "limits": {
      "$ref": "#/definitions/SkillLimits"
    },
    "name": {
      "default": "",
      "type": "string"
    },
    "revision": {
      "default": "",
      "type": "string"
    },
    "scope": {
      "default": "global",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/definitions/SkillSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "limits"
  ],
  "title": "SkillBundle",
  "type": "object"
}
