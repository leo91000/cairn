{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "PluginResource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resourceType": {
          "type": "string"
        }
      },
      "required": [
        "resourceType",
        "id",
        "name",
        "parent"
      ],
      "type": "object"
    },
    "PluginResourceRef": {
      "additionalProperties": false,
      "description": "A resource identity is scoped to a plugin instance and a declared type.",
      "properties": {
        "id": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        }
      },
      "required": [
        "resourceType",
        "id"
      ],
      "type": "object"
    }
  },
  "properties": {
    "items": {
      "items": {
        "$ref": "#/definitions/PluginResource"
      },
      "type": "array"
    },
    "nextPage": {
      "format": "int64",
      "maximum": 10000,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "items",
    "nextPage"
  ],
  "title": "ListPluginResourcesOutput",
  "type": "object"
}
