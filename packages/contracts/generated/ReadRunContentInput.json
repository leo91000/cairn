{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "offset": {
      "default": 0,
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "runId": {
      "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
      "format": "uuid",
      "type": "string"
    },
    "sha256": {
      "default": null,
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "runId"
  ],
  "title": "ReadRunContentInput",
  "type": "object"
}
