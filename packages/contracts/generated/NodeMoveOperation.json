{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "MoveToNodeOutput": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "format": "uuid",
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "nodeId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "errorStatus": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/definitions/MoveToNodeOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "pattern": "^(running|completed|failed|cancelled)$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "state",
    "result",
    "error",
    "errorStatus"
  ],
  "title": "NodeMoveOperation",
  "type": "object"
}
