{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Owner-only, from the web and Android apps: never a public MCP or agent tool.",
  "properties": {
    "accountId": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "agentId": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "agentId",
    "accountId"
  ],
  "title": "AgentAccountInput",
  "type": "object"
}
