{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "acquisitionTimeoutSeconds": {
      "default": 300,
      "format": "uint64",
      "maximum": 3600,
      "minimum": 1,
      "type": "integer"
    },
    "durationSeconds": {
      "format": "uint64",
      "maximum": 900,
      "minimum": 1,
      "type": "integer"
    },
    "memberRunIds": {
      "default": [],
      "items": {
        "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "minimumAvailableMemoryMiB": {
      "default": 0,
      "format": "uint64",
      "maximum": 1073741824,
      "minimum": 0,
      "type": "integer"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "waitSeconds": {
      "default": 300,
      "format": "uint64",
      "maximum": 3600,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "durationSeconds",
    "reason"
  ],
  "title": "AcquireExclusiveInput",
  "type": "object"
}
