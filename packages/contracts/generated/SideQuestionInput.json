{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Client-chosen identity: retrying with the same content returns the same question.",
      "format": "uuid",
      "type": "string"
    },
    "itemId": {
      "default": "",
      "maxLength": 200,
      "type": "string"
    },
    "quote": {
      "default": "",
      "maxLength": 4000,
      "type": "string"
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "text"
  ],
  "title": "SideQuestionInput",
  "type": "object"
}
