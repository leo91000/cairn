{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "nodeId": {
      "format": "uuid",
      "type": "string"
    },
    "requiredTags": {
      "items": {
        "maxLength": 40,
        "minLength": 1,
        "pattern": "^(?!.*[^A-Za-z0-9_:./-]).+$",
        "type": "string"
      },
      "maxItems": 32,
      "type": [
        "array",
        "null"
      ]
    },
    "runId": {
      "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
      "format": "uuid",
      "type": "string"
    },
    "waitSeconds": {
      "default": 0,
      "format": "uint64",
      "maximum": 3600,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "runId",
    "nodeId"
  ],
  "title": "MoveToNodeInput",
  "type": "object"
}
