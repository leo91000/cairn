{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "QualificationFixture": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
          "format": "uuid",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "names": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "nullable": {
          "type": [
            "string",
            "null"
          ]
        },
        "omitted": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "$ref": "#/definitions/QualificationResult"
        }
      },
      "required": [
        "id",
        "result",
        "enabled",
        "nullable",
        "count",
        "labels",
        "names"
      ],
      "type": "object"
    },
    "QualificationResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "resumed",
              "type": "string"
            },
            "runId": {
              "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "runId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rejected",
              "type": "string"
            },
            "response": {
              "$ref": "#/definitions/ResumeRunError"
            }
          },
          "required": [
            "kind",
            "response"
          ],
          "type": "object"
        }
      ]
    },
    "ResumeRunError": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "ResumeRunInput": {
      "additionalProperties": false,
      "properties": {
        "runId": {
          "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "runId"
      ],
      "type": "object"
    },
    "ResumeRunOutput": {
      "additionalProperties": false,
      "properties": {
        "runId": {
          "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "runId"
      ],
      "type": "object"
    }
  }
}
