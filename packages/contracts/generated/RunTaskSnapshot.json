{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Frozen conversation prompt and identity metadata captured in a run snapshot.",
  "properties": {
    "agentId": {
      "default": "",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "default": "",
      "type": "string"
    },
    "projectId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "prompt": {
      "default": "",
      "type": "string"
    },
    "worktree": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "prompt",
    "agentId",
    "projectId",
    "worktree"
  ],
  "title": "RunTaskSnapshot",
  "type": "object"
}
