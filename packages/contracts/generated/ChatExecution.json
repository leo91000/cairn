{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ChatAttachment": {
      "properties": {
        "chatId": {
          "default": "",
          "type": "string"
        },
        "createdAt": {
          "default": 0,
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "digest": {
          "default": "",
          "type": "string"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "default": "file",
          "pattern": "^(image|file)$",
          "type": "string"
        },
        "mediaType": {
          "default": "application/octet-stream",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "default": 0,
          "format": "uint64",
          "maximum": 41943040,
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "CompactionReply": {
      "properties": {
        "finishedAt": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "outcome": {
          "additionalProperties": true,
          "type": [
            "object",
            "null"
          ],
          "x-kotlin-type": "TaskOutcome"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "attachments": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ChatAttachment"
      },
      "type": "array"
    },
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "messageId": {
      "type": "string"
    },
    "operation": {
      "pattern": "^compact$",
      "type": [
        "string",
        "null"
      ]
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#/definitions/CompactionReply"
        },
        {
          "type": "null"
        }
      ]
    },
    "recovery": {
      "default": false,
      "type": "boolean"
    },
    "text": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "messageId"
  ],
  "title": "ChatExecution",
  "type": "object"
}
