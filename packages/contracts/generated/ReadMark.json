{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ReadTarget": {
      "description": "Work an account can read: a conversation's latest turn or a mission's latest run.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "chatId": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "chat",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "chatId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "mission",
              "type": "string"
            },
            "taskId": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "taskId"
          ],
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "finishedAt": {
      "description": "When the work the account saw finished. Later work stays unread.",
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "target": {
      "$ref": "#/definitions/ReadTarget"
    }
  },
  "required": [
    "target",
    "finishedAt"
  ],
  "title": "ReadMark",
  "type": "object"
}
