{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InstalledProgram": {
      "additionalProperties": false,
      "properties": {
        "archiveSha256": {
          "type": "string"
        },
        "binarySha256": {
          "type": "string"
        },
        "release": {
          "$ref": "#/definitions/ProgramRelease"
        }
      },
      "required": [
        "release",
        "archiveSha256",
        "binarySha256"
      ],
      "type": "object"
    },
    "ManagePluginOutput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "callbackUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "setup",
              "type": "string"
            },
            "managementUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "manifest": {
              "$ref": "#/definitions/PluginManifest"
            },
            "setup": {
              "$ref": "#/definitions/PluginSetup"
            }
          },
          "required": [
            "kind",
            "manifest",
            "setup",
            "callbackUrl",
            "managementUrl"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "form": {
              "$ref": "#/definitions/PluginFormResult"
            },
            "kind": {
              "const": "form",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "form"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "instance": {
              "$ref": "#/definitions/PluginConnection"
            },
            "kind": {
              "const": "saved",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "instance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "instance": {
              "$ref": "#/definitions/PluginConnection"
            },
            "kind": {
              "const": "enabled",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "instance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "deleted": {
              "type": "boolean"
            },
            "kind": {
              "const": "deleted",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "deleted"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "disconnected": {
              "type": "boolean"
            },
            "kind": {
              "const": "disconnected",
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "revoked": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "disconnected",
            "revoked",
            "message"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tested",
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "ok",
            "message"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "view",
              "type": "string"
            },
            "view": true
          },
          "required": [
            "kind",
            "view"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The package-defined view/action result has already passed its manifest validator.",
          "properties": {
            "kind": {
              "const": "action",
              "type": "string"
            },
            "result": true
          },
          "required": [
            "kind",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "flow": {
              "$ref": "#/definitions/PluginSigninFlow"
            },
            "kind": {
              "const": "signin",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "flow"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cancelled": {
              "type": "boolean"
            },
            "kind": {
              "const": "signinCancelled",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cancelled"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "instance": {
              "$ref": "#/definitions/PluginConnection"
            },
            "kind": {
              "const": "people",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "instance"
          ],
          "type": "object"
        }
      ]
    },
    "PackageVersion": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "items": {
            "$ref": "#/definitions/PluginFile"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginSetup"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "PluginActivity": {
      "additionalProperties": false,
      "properties": {
        "chatId": {
          "default": "",
          "type": "string"
        },
        "createdAt": {
          "default": 0,
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "preview": {
          "default": "",
          "type": "string"
        },
        "status": {
          "default": "working",
          "pattern": "^(working|replied|failed|stopped)$",
          "type": "string"
        },
        "userId": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id",
        "chatId",
        "userId",
        "name",
        "preview",
        "status",
        "createdAt"
      ],
      "type": "object"
    },
    "PluginAgentAccess": {
      "additionalProperties": false,
      "description": "Agents the owner grants on each instance may run the package's commands and tools.",
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "type": "object"
    },
    "PluginArgument": {
      "additionalProperties": false,
      "description": "One flag (`--vault ID`) or positional value of a command. Values are text.",
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxLength": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "pattern": {
          "description": "A regular expression the whole value must match.",
          "type": [
            "string",
            "null"
          ]
        },
        "positional": {
          "default": false,
          "type": "boolean"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "PluginBrand": {
      "additionalProperties": false,
      "description": "The package's mark: a background colour and an SVG path on a 24×24 grid.",
      "properties": {
        "color": {
          "description": "`#rrggbb`.",
          "type": "string"
        },
        "path": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "color"
      ],
      "type": "object"
    },
    "PluginCommand": {
      "additionalProperties": false,
      "description": "A command agents run in their conversation: `cairn plugin <plugin> <name> …`.",
      "properties": {
        "arguments": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PluginArgument"
          },
          "type": "array"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "default": "json",
          "pattern": "^(json|text|secret)$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "output"
      ],
      "type": "object"
    },
    "PluginCondition": {
      "additionalProperties": false,
      "description": "A condition granted agents can wait for with `wait_for`, observed by the `condition`\nhandler. Its type is `<plugin>_<name>`, like a tool name.",
      "properties": {
        "description": {
          "type": "string"
        },
        "inputSchema": {
          "description": "Properties besides `type` (and `projectId` with `project`)."
        },
        "name": {
          "type": "string"
        },
        "project": {
          "default": false,
          "description": "Pinned to one of the run's projects: Cairn checks it is authorized and passes it.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "inputSchema"
      ],
      "type": "object"
    },
    "PluginConnection": {
      "additionalProperties": false,
      "description": "Explicit owner/agent view: no credential, approved policy or native provenance.",
      "properties": {
        "accessMode": {
          "default": "allowlist",
          "pattern": "^(allowlist|requests|everyone)$",
          "type": "string"
        },
        "activity": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PluginActivity"
          },
          "type": "array"
        },
        "agentId": {
          "default": "",
          "type": "string"
        },
        "agentIds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "maxMessagesPerHour": {
          "default": 20,
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "maxPerPersonPerHour": {
          "default": 5,
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "people": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PluginLabel"
          },
          "type": "array"
        },
        "pluginId": {
          "default": "",
          "type": "string"
        },
        "projectId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "requests": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PluginRequest"
          },
          "type": "array"
        },
        "revision": {
          "default": "",
          "type": "string"
        },
        "secretKeys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "settings": {
          "additionalProperties": true,
          "description": "Validated against the selected package's manifest, never used for Cairn policy.",
          "type": "object",
          "x-cairn-json-object": true
        },
        "status": {
          "$ref": "#/definitions/PluginStatus"
        },
        "usage": {
          "$ref": "#/definitions/PluginUsage"
        },
        "userIds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "pluginId",
        "name",
        "enabled",
        "revision",
        "settings",
        "secretKeys",
        "agentIds",
        "agentId",
        "projectId",
        "accessMode",
        "userIds",
        "people",
        "maxMessagesPerHour",
        "maxPerPersonPerHour",
        "status",
        "usage",
        "requests",
        "activity"
      ],
      "type": "object"
    },
    "PluginCredential": {
      "additionalProperties": false,
      "description": "How the host injects a connection's secret into authorized HTTP requests.\nPlugin code never receives the secret itself.",
      "properties": {
        "deviceFlow": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginDeviceFlow"
            },
            {
              "type": "null"
            }
          ],
          "description": "The owner may sign in instead of pasting the credential."
        },
        "header": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginOAuth"
            },
            {
              "type": "null"
            }
          ],
          "description": "Authorization-code sign-in with PKCE and host-owned refresh tokens."
        },
        "prefix": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "label",
        "header",
        "prefix"
      ],
      "type": "object"
    },
    "PluginDeviceFlow": {
      "additionalProperties": false,
      "description": "OAuth 2.0 device authorization grant (RFC 8628), run by the host for the owner.\nThe token obtained becomes the instance's credential; scripts never see it.",
      "properties": {
        "authorizationUrl": {
          "description": "Where the host asks for a device and user code. HTTPS on a declared host.",
          "type": "string"
        },
        "clientId": {
          "description": "The public client ID of the package publisher's OAuth application.",
          "type": "string"
        },
        "scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tokenUrl": {
          "description": "Where the host polls for the token. HTTPS on a declared host.",
          "type": "string"
        }
      },
      "required": [
        "authorizationUrl",
        "tokenUrl",
        "clientId"
      ],
      "type": "object"
    },
    "PluginFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes"
      ],
      "type": "object"
    },
    "PluginFormResult": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "options": {
          "additionalProperties": {
            "items": {
              "$ref": "#/definitions/PluginOption"
            },
            "type": "array"
          },
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "description": "Validated against the selected package's manifest, never used for Cairn policy.",
          "type": "object",
          "x-cairn-json-object": true
        },
        "view": {
          "default": [],
          "items": true,
          "type": "array"
        }
      },
      "required": [
        "options",
        "values",
        "errors",
        "view"
      ],
      "type": "object"
    },
    "PluginGitCredential": {
      "additionalProperties": false,
      "description": "Git credentials for one HTTPS remote prefix, kept in a store file Cairn owns.",
      "properties": {
        "password": {
          "type": "string"
        },
        "url": {
          "description": "`https://host` or `https://host/path`, on a declared host.",
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "username",
        "password"
      ],
      "type": "object"
    },
    "PluginGitIdentity": {
      "additionalProperties": false,
      "description": "The commit author of runs, when the installation has no global Git identity.",
      "properties": {
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ],
      "type": "object"
    },
    "PluginInstances": {
      "additionalProperties": false,
      "description": "How the owner's interfaces name one configured instance, e.g. \"Service account\".",
      "properties": {
        "plural": {
          "type": "string"
        },
        "singular": {
          "type": "string"
        }
      },
      "required": [
        "singular",
        "plural"
      ],
      "type": "object"
    },
    "PluginLabel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "PluginManifest": {
      "additionalProperties": false,
      "properties": {
        "agentAccess": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginAgentAccess"
            },
            {
              "type": "null"
            }
          ]
        },
        "apiVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "brand": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginBrand"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "commands": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PluginCommand"
          },
          "type": "array"
        },
        "conditions": {
          "default": [],
          "description": "Conditions granted agents wait for, observed by the `condition` handler.",
          "items": {
            "$ref": "#/definitions/PluginCondition"
          },
          "type": "array"
        },
        "credential": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginCredential"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "default": "",
          "description": "One sentence shown in the owner's plugin catalogue.",
          "type": "string"
        },
        "hosts": {
          "default": [],
          "description": "Hostnames reachable through `http` (HTTPS) and `socket` (WSS). `*.example.com`\ncovers every subdomain of `example.com`, not the domain itself.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "instanceForm": {
          "default": false,
          "description": "The script's `form` handler fills dynamic choices, derived values, errors and\nguidance while the owner edits an instance, and checks it before it is saved.",
          "type": "boolean"
        },
        "instanceTest": {
          "default": false,
          "description": "The script's `test` handler checks an instance.",
          "type": "boolean"
        },
        "instanceView": {
          "default": false,
          "description": "The script's `view` handler describes each instance's panel.",
          "type": "boolean"
        },
        "instances": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginInstances"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions": {
          "default": "",
          "description": "Added to the prompt of runs whose agent is granted on an enabled instance.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "programs": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PluginProgram"
          },
          "type": "array"
        },
        "projectSources": {
          "default": [],
          "description": "Projects the owner can import through the `projects` handler.",
          "items": {
            "$ref": "#/definitions/PluginProjectSource"
          },
          "type": "array"
        },
        "runCredentials": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginRunCredentials"
            },
            {
              "type": "null"
            }
          ],
          "description": "Files, Git credentials and identity rendered into granted agents' runs."
        },
        "secretPatterns": {
          "default": [],
          "description": "Regular expressions of the service's token formats, masked in run output.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "settings": {
          "default": [],
          "description": "Instance fields Cairn renders, in order: `[{ key, title, type, ... }]`.",
          "items": true,
          "type": "array"
        },
        "setup": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginSetup"
            },
            {
              "type": "null"
            }
          ],
          "description": "What connecting an instance takes and the steps the owner follows."
        },
        "skillSources": {
          "default": [],
          "description": "Skill sources the owner imports from through the `skills` handler.",
          "items": {
            "$ref": "#/definitions/PluginSkillSource"
          },
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PluginTool"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "description",
        "apiVersion",
        "capabilities"
      ],
      "type": "object"
    },
    "PluginOAuth": {
      "additionalProperties": false,
      "description": "A provider-independent authorization-code flow. Client settings and secrets are\ndeclared form fields; credentials and PKCE material never enter package code.",
      "properties": {
        "authorizationParameters": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "authorizationUrl": {
          "type": "string"
        },
        "clientIdSetting": {
          "type": "string"
        },
        "clientSecretSetting": {
          "type": [
            "string",
            "null"
          ]
        },
        "requireRefreshToken": {
          "default": false,
          "type": "boolean"
        },
        "revocationUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "scopeSettings": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Additional scopes for enabled boolean settings, e.g. sending or deletion.",
          "type": "object"
        },
        "scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tokenUrl": {
          "type": "string"
        }
      },
      "required": [
        "requireRefreshToken",
        "authorizationUrl",
        "tokenUrl",
        "clientIdSetting",
        "scopes",
