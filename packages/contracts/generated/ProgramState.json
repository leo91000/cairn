{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "InstalledProgram": {
      "additionalProperties": false,
      "properties": {
        "archiveSha256": {
          "type": "string"
        },
        "binarySha256": {
          "type": "string"
        },
        "release": {
          "$ref": "#/definitions/ProgramRelease"
        }
      },
      "required": [
        "release",
        "archiveSha256",
        "binarySha256"
      ],
      "type": "object"
    },
    "ProgramRelease": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string"
        },
        "format": {
          "pattern": "^(zip|binary)$",
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "url",
        "format",
        "executable"
      ],
      "type": "object"
    }
  },
  "properties": {
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProgramRelease"
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "installed": {
      "anyOf": [
        {
          "$ref": "#/definitions/InstalledProgram"
        },
        {
          "type": "null"
        }
      ]
    },
    "installer": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#/definitions/InstalledProgram"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name",
    "installer",
    "installed",
    "previous",
    "candidate",
    "digest"
  ],
  "title": "ProgramState",
  "type": "object"
}
