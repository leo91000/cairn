  "additionalProperties": false,
  "description": "One revocable, unlisted live conversation link. Times are Unix milliseconds.",
  "properties": {
    "expiresAt": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "publicUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "token": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "ChatShare",
  "type": "object"
}
