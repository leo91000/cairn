{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "limit": {
      "default": 20,
      "format": "uint16",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "default": null,
      "pattern": "^(queued|running|waiting|succeeded|failed|cancelled|interrupted)$",
      "type": [
        "string",
        "null"
      ]
    },
    "taskId": {
      "default": null,
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "ListRunsInput",
  "type": "object"
}
