{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "SkillSource": {
      "additionalProperties": false,
      "properties": {
        "folder": {
          "default": "",
          "type": "string"
        },
        "importedAt": {
          "default": 0,
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "instance": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "location": {
          "additionalProperties": true,
          "description": "Validated against the selected package's manifest, never used for Cairn policy.",
          "type": "object",
          "x-cairn-json-object": true
        },
        "modified": {
          "default": false,
          "type": "boolean"
        },
        "pluginId": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "location"
      ],
      "type": "object"
    }
  },
  "properties": {
    "bytes": {
      "default": 0,
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "content": {
      "default": "",
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "executables": {
      "default": 0,
      "format": "uint32",
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "files": {
      "default": 0,
      "format": "uint32",
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "default": "",
      "type": "string"
    },
    "path": {
      "default": "",
      "type": "string"
    },
    "scope": {
      "default": "global",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/definitions/SkillSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "usageCount": {
      "default": 0,
      "format": "uint32",
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "valid": {
      "default": true,
      "type": "boolean"
    }
  },
  "title": "Skill",
  "type": "object"
}
