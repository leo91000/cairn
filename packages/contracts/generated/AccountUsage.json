{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AccountResets": {
      "properties": {
        "available": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "credits": {
          "default": [],
          "description": "Codex's own credit objects, kept verbatim.",
          "items": {
            "additionalProperties": true,
            "description": "Validated against the selected package's manifest, never used for Cairn policy.",
            "type": "object",
            "x-cairn-json-object": true
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AccountWindow": {
      "properties": {
        "durationMins": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "models": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reached": {
          "default": false,
          "type": "boolean"
        },
        "resetsAt": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "usedPercent": {
          "default": null,
          "description": "Kept as reported, so integer readings stay integers.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "allowed": {
      "default": true,
      "type": "boolean"
    },
    "attemptedAt": {
      "description": "The last reading attempt, successful or not (Claude Code and OpenCode Go).",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "checkedAt": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "resets": {
      "anyOf": [
        {
          "$ref": "#/definitions/AccountResets"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Codex banked resets."
    },
    "useBalance": {
      "type": "boolean"
    },
    "windows": {
      "default": [],
      "items": {
        "$ref": "#/definitions/AccountWindow"
      },
      "type": "array"
    }
  },
  "title": "AccountUsage",
  "type": "object"
}
