{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "chatId": {
      "format": "uuid",
      "type": "string"
    },
    "provider": {
      "pattern": "^(codex|claude|opencode)$",
      "type": "string"
    },
    "requestId": {
      "format": "uuid",
      "type": "string"
    },
    "runId": {
      "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
      "format": "uuid",
      "type": "string"
    },
    "turnId": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "chatId",
    "runId",
    "requestId",
    "turnId",
    "provider"
  ],
  "title": "SwitchChatCodingAgentInput",
  "type": "object"
}
