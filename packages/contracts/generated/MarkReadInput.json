{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ReadMark": {
      "additionalProperties": false,
      "properties": {
        "finishedAt": {
          "description": "Observed Chat.readAt or finish time, including questions and errors. Later work stays unread.",
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "snoozedUntil": {
          "description": "The observed deadline when explicitly marking a snoozed conversation as read.",
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "target": {
          "$ref": "#/definitions/ReadTarget"
        }
      },
      "required": [
        "target",
        "finishedAt"
      ],
      "type": "object"
    },
    "ReadTarget": {
      "description": "Work an account can read: a conversation's latest turn or pending question.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "chatId": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "chat",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "chatId"
          ],
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "items": {
      "items": {
        "$ref": "#/definitions/ReadMark"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "MarkReadInput",
  "type": "object"
}
