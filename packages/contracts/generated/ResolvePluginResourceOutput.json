{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "PluginResource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/definitions/PluginResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resourceType": {
          "type": "string"
        }
      },
      "required": [
        "resourceType",
        "id",
        "name",
        "parent"
      ],
      "type": "object"
    },
    "PluginResourceRef": {
      "additionalProperties": false,
      "description": "A resource identity is scoped to a plugin instance and a declared type.",
      "properties": {
        "id": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        }
      },
      "required": [
        "resourceType",
        "id"
      ],
      "type": "object"
    }
  },
  "properties": {
    "ancestors": {
      "description": "Nearest parent first, through the root. Cairn resolves each parent itself.",
      "items": {
        "$ref": "#/definitions/PluginResource"
      },
      "type": "array"
    },
    "resource": {
      "$ref": "#/definitions/PluginResource"
    }
  },
  "required": [
    "resource",
    "ancestors"
  ],
  "title": "ResolvePluginResourceOutput",
  "type": "object"
}
