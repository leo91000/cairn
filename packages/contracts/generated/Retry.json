{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Cause": {
      "properties": {
        "kind": {
          "pattern": "^(connection|timeout|rate-limit|server)$",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "startup": {
          "default": false,
          "description": "The adapter confirmed that no new agent turn was submitted.",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "message",
        "startup"
      ],
      "type": "object"
    }
  },
  "properties": {
    "attempt": {
      "format": "uint64",
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "cause": {
      "$ref": "#/definitions/Cause"
    },
    "deadlineAt": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "limit": {
      "format": "uint64",
      "maximum": 5,
      "minimum": 5,
      "type": "integer"
    },
    "nextAttemptAt": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "startedAt": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "attempt",
    "limit",
    "nextAttemptAt",
    "startedAt",
    "deadlineAt",
    "cause"
  ],
  "title": "Retry",
  "type": "object"
}
