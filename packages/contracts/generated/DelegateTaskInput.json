{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "agentId": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "maxLength": 120,
      "pattern": "^[\\w./:\\[\\]-]*$",
      "type": [
        "string",
        "null"
      ]
    },
    "projectId": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "pattern": "^(codex|claude|opencode)$",
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning": {
      "maxLength": 40,
      "pattern": "^(?:[a-z][a-z0-9_-]*)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "format": "uuid",
      "type": "string"
    },
    "task": {
      "maxLength": 50000,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "maxLength": 90,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "task"
  ],
  "title": "DelegateTaskInput",
  "type": "object"
}
