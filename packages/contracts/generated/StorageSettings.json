{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "The default S3 storage for new disks, without its credentials.",
  "properties": {
    "bucket": {
      "type": "string"
    },
    "configured": {
      "type": "boolean"
    },
    "endpoint": {
      "type": "string"
    },
    "environmentManaged": {
      "type": "boolean"
    },
    "integrated": {
      "type": "boolean"
    },
    "region": {
      "type": "string"
    }
  },
  "required": [
    "configured",
    "integrated",
    "environmentManaged",
    "bucket",
    "endpoint",
    "region"
  ],
  "title": "StorageSettings",
  "type": "object"
}
