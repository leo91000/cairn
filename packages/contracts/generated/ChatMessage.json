{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ChatAttachment": {
      "properties": {
        "chatId": {
          "default": "",
          "type": "string"
        },
        "createdAt": {
          "default": 0,
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "digest": {
          "default": "",
          "type": "string"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "default": "file",
          "pattern": "^(image|file)$",
          "type": "string"
        },
        "mediaType": {
          "default": "application/octet-stream",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "default": 0,
          "format": "uint64",
          "maximum": 41943040,
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "attachments": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ChatAttachment"
      },
      "type": "array"
    },
    "chatId": {
      "default": "",
      "type": "string"
    },
    "createdAt": {
      "default": 0,
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "mode": {
      "default": "queue",
      "pattern": "^(queue|steer)$",
      "type": "string"
    },
    "model": {
      "default": "",
      "type": "string"
    },
    "provider": {
      "default": "",
      "pattern": "^(|codex|claude|opencode)$",
      "type": "string"
    },
    "questionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning": {
      "default": "",
      "type": "string"
    },
    "revision": {
      "default": "",
      "type": "string"
    },
    "speed": {
      "default": "",
      "type": "string"
    },
    "status": {
      "default": "queued",
      "pattern": "^(queued|sending|delivered|cancelled)$",
      "type": "string"
    },
    "text": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "ChatMessage",
  "type": "object"
}
