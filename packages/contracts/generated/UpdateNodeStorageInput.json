{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "NodeStoragePolicy": {
      "additionalProperties": false,
      "properties": {
        "backupSeconds": {
          "default": 60,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cacheMiB": {
          "default": 102400,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxDirtySeconds": {
          "default": 300,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memoryCacheMiB": {
          "default": 256,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reserveMiB": {
          "default": 10240,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reservePercent": {
          "default": 5,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "nodeId": {
      "format": "uuid",
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "storage": {
      "$ref": "#/definitions/NodeStoragePolicy"
    }
  },
  "required": [
    "nodeId",
    "revision",
    "storage"
  ],
  "title": "UpdateNodeStorageInput",
  "type": "object"
}
