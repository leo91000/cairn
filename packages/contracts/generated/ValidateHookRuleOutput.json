{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "HookRuleProblem": {
      "additionalProperties": false,
      "description": "A problem that prevents saving, located by a JSON Pointer into the definition.",
      "properties": {
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "type": "object"
    },
    "HookRuleWarning": {
      "additionalProperties": false,
      "description": "A warning shown to the rule's creator, which does not prevent saving.",
      "properties": {
        "kind": {
          "pattern": "^openToAnyone$",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  },
  "properties": {
    "problems": {
      "items": {
        "$ref": "#/definitions/HookRuleProblem"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/definitions/HookRuleWarning"
      },
      "type": "array"
    }
  },
  "required": [
    "problems",
    "warnings"
  ],
  "title": "ValidateHookRuleOutput",
  "type": "object"
}
