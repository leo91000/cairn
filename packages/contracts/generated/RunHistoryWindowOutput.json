{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "EventPreview": {
      "properties": {
        "createdAt": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "id": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "runId",
        "createdAt"
      ],
      "type": "object"
    },
    "RunEvent": {
      "description": "The event's ordering identity is distinct from a client's presentation identity.",
      "properties": {
        "createdAt": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "displayId": {
          "description": "Client cache identity; never supplied by the event writer.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "payload": {
          "additionalProperties": true,
          "description": "Redacted adapter JSON, retained without constructing a second object tree.",
          "type": [
            "object",
            "null"
          ],
          "x-cairn-json-object": true
        },
        "runId": {
          "default": "",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timeline": {
          "description": "The timeline presents this event. Clients render it only through its\ncard and read it as a boundary of families that are not converted yet.",
          "type": "boolean"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "createdAt",
        "type",
        "text",
        "runId"
      ],
      "type": "object"
    },
    "RunEventPage": {
      "description": "An oversized event retains its cursor, while its exact JSON remains available\nthrough read_run_content. No success-shaped partial event is returned.",
      "oneOf": [
        {
          "properties": {
            "event": {
              "$ref": "#/definitions/RunEvent"
            },
            "kind": {
              "const": "complete",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "event"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "truncated",
              "type": "string"
            },
            "preview": {
              "$ref": "#/definitions/EventPreview"
            },
            "totalBytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "preview",
            "totalBytes"
          ],
          "type": "object"
        }
      ]
    }
  },
  "description": "Agent windows use bounded previews; UI history retains its full event frames.",
  "properties": {
    "events": {
      "items": {
        "$ref": "#/definitions/RunEventPage"
      },
      "type": "array"
    },
    "hasOlder": {
      "type": "boolean"
    },
    "history": {
      "type": "string"
    },
    "oldest": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "events",
    "history",
    "oldest",
    "hasOlder"
  ],
  "title": "RunHistoryWindowOutput",
  "type": "object"
}
