{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "One recorded installation change; `detail` is the JSON recorded with it.",
  "properties": {
    "action": {
      "type": "string"
    },
    "createdAt": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "detail": {
      "type": "string"
    },
    "id": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "createdAt",
    "action",
    "detail"
  ],
  "title": "AuditEntry",
  "type": "object"
}
