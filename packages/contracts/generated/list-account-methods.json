        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "label"
        ],
        "type": "object"
      }
    },
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "kind": {
