              "$ref": "#/definitions/AccountSignInMethod"
            },
            "type": "array"
          }
        },
        "required": [
          "kind",
          "methods"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "accountProofRequired",
