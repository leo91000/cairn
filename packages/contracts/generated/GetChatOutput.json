        "backend": {
          "default": "firecracker",
          "pattern": "^(auto|firecracker|native)$",
          "type": "string"
        },
        "delegation": {
          "default": false,
          "type": "boolean"
        },
        "installation": {
          "default": false,
          "type": "boolean"
        },
        "mcpTools": {
          "additionalProperties": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 500,
            "type": "array"
          },
          "propertyNames": {
            "format": "uuid",
            "type": "string"
          },
          "type": "object"
        },
        "mcps": {
          "default": null,
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "type": [
            "array",
            "null"
          ]
        },
        "nodes": {
          "default": [
            "00000000-0000-4000-8000-000000000002"
          ],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "type": [
            "array",
            "null"
          ]
        },
        "projects": {
          "default": null,
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "type": [
            "array",
            "null"
          ]
        },
        "sandbox": {
          "default": "yolo",
          "pattern": "^(yolo|workspace-write|read-only)$",
          "type": "string"
        },
        "skills": {
          "default": null,
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 100,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "mcpTools"
      ],
      "type": "object"
    },
    "Agent": {
      "properties": {
        "access": {
          "$ref": "#/definitions/AccessPolicy"
        },
        "avatar": {
          "anyOf": [
