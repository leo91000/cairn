        "description": {
          "default": "",
          "maxLength": 500,
          "type": "string"
        },
        "exclusiveNodes": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "instructions": {
          "default": "",
          "maxLength": 20000,
          "type": "string"
        },
        "model": {
          "default": "",
          "maxLength": 100,
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "nodePriorities": {
          "default": [],
          "description": "Preferred placement order. This does not grant access to any node.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "plugins": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "provider": {
          "default": "codex",
          "pattern": "^(codex|claude|opencode)$",
          "type": "string"
        },
        "reasoning": {
          "default": "high",
          "maxLength": 40,
          "pattern": "^(?:[a-z][a-z0-9_-]*)?$",
          "type": "string"
