        "revision": {
          "type": "string"
        },
        "speed": {
          "default": "",
          "maxLength": 40,
          "pattern": "^(?:[a-z][a-z0-9_-]*)?$",
          "type": "string"
        },
        "timeoutMinutes": {
          "default": 0,
          "format": "uint16",
          "maximum": 720,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "access",
        "exclusiveNodes",
        "plugins",
        "revision",
        "createdAt"
      ],
      "type": "object"
