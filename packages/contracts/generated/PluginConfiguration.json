{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "PluginLabel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "description": "Full Cairn configuration, with manifest settings and secret fields separate.\nMissing agentIds retains grants; agents are forbidden from submitting it at all.",
  "properties": {
    "accessMode": {
      "default": "allowlist",
      "pattern": "^(allowlist|requests|everyone)$",
      "type": "string"
    },
    "agentId": {
      "default": "",
      "type": "string"
    },
    "agentIds": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 100,
      "type": [
        "array",
        "null"
      ]
    },
    "credentialFlow": {
      "maxLength": 200,
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "maxMessagesPerHour": {
      "default": 20,
      "format": "uint32",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "maxPerPersonPerHour": {
      "default": 5,
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "people": {
      "default": [],
      "items": {
        "$ref": "#/definitions/PluginLabel"
      },
      "maxItems": 100,
      "type": "array"
    },
    "projectId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "description": "Required on replacement. Creation has no existing revision.",
      "type": [
        "string",
        "null"
      ]
    },
    "secrets": {
      "additionalProperties": true,
      "description": "Validated against the selected package's manifest, never used for Cairn policy.",
      "type": [
        "object",
        "null"
      ],
      "x-cairn-json-object": true
    },
    "settings": {
      "additionalProperties": true,
      "description": "Validated against the selected package's manifest, never used for Cairn policy.",
      "type": "object",
      "x-cairn-json-object": true
    },
    "sharedFrom": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "token": {
      "maxLength": 16384,
      "type": [
        "string",
        "null"
      ]
    },
    "userIds": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    }
  },
  "required": [
    "name",
    "enabled",
    "settings"
  ],
  "title": "PluginConfiguration",
  "type": "object"
}
