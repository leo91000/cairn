{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ExclusiveReservation": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiresAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "minimumAvailableMemoryMiB": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "nodeId": {
          "type": "string"
        },
        "ownerRunId": {
          "type": "string"
        },
        "pausedRunIds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        },
        "renewalPending": {
          "default": false,
          "type": "boolean"
        },
        "state": {
          "pattern": "^(queued|acquiring|acquired|releasing|released|failed|expired)$",
          "type": "string"
        },
        "waitUntil": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "nodeId",
        "ownerRunId",
        "reason",
        "state",
        "createdAt",
        "expiresAt",
        "renewalPending",
        "waitUntil",
        "pausedRunIds",
        "minimumAvailableMemoryMiB",
        "error"
      ],
      "type": "object"
    }
  },
  "description": "An object result is accepted by both legacy and current MCP tool codecs.",
  "properties": {
    "reservations": {
      "items": {
        "$ref": "#/definitions/ExclusiveReservation"
      },
      "maxItems": 20,
      "type": "array"
    }
  },
  "required": [
    "reservations"
  ],
  "title": "ExclusiveStatusOutput",
  "type": "object"
}
