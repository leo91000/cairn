{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Frozen per message. Contains editable settings only, never credentials.",
  "properties": {
    "agentId": {
      "description": "Profile that supplied these defaults, even if the conversation is later transferred.",
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "configuredPaths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "document": {
      "type": "string"
    },
    "provider": {
      "pattern": "^(codex|claude|opencode)$",
      "type": "string"
    },
    "revision": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "document",
    "revision",
    "configuredPaths"
  ],
  "title": "NativeConfigurationSnapshot",
  "type": "object"
}
