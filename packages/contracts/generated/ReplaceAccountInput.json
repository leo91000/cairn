{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AccountSettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxConcurrentRuns": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "enabled",
        "maxConcurrentRuns"
      ],
      "type": "object"
    }
  },
  "properties": {
    "accountId": {
      "format": "uuid",
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "settings": {
      "$ref": "#/definitions/AccountSettings"
    }
  },
  "required": [
    "revision",
    "accountId",
    "settings"
  ],
  "title": "ReplaceAccountInput",
  "type": "object"
}
