{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "McpEnvironment": {
      "additionalProperties": {
        "maxLength": 10000,
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_]\\w*$",
        "type": "string"
      },
      "type": "object"
    }
  },
  "properties": {
    "allowPrivateNetwork": {
      "default": false,
      "type": "boolean"
    },
    "args": {
      "default": [],
      "items": {
        "maxLength": 4000,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "auth": {
      "default": "none",
      "pattern": "^(none|bearer|oauth)$",
      "type": "string"
    },
    "clientId": {
      "default": "",
      "maxLength": 500,
      "type": "string"
    },
    "clientSecret": {
      "maxLength": 10000,
      "type": [
        "string",
        "null"
      ]
    },
    "command": {
      "default": "",
      "maxLength": 1000,
      "type": "string"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "enabledTools": {
      "default": null,
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 500,
      "type": [
        "array",
        "null"
      ]
    },
    "env": {
      "anyOf": [
        {
          "$ref": "#/definitions/McpEnvironment"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "removeEnv": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "type": "array"
    },
    "scopes": {
      "default": "",
      "maxLength": 2000,
      "type": "string"
    },
    "token": {
      "maxLength": 10000,
      "type": [
        "string",
        "null"
      ]
    },
    "transport": {
      "default": "http",
      "pattern": "^(http|stdio)$",
      "type": "string"
    },
    "url": {
      "default": "",
      "maxLength": 2000,
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "McpInput",
  "type": "object"
}
