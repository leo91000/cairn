{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ResumeExecutionSelection": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 120,
          "type": "string"
        },
        "reasoning": {
          "maxLength": 40,
          "pattern": "^(?:[a-z][a-z0-9_-]*)?$",
          "type": "string"
        },
        "speed": {
          "maxLength": 40,
          "pattern": "^(?:[a-z][a-z0-9_-]*)?$",
          "type": "string"
        }
      },
      "required": [
        "model",
        "reasoning",
        "speed"
      ],
      "type": "object"
    }
  },
  "properties": {
    "chatId": {
      "format": "uuid",
      "type": "string"
    },
    "runId": {
      "description": "Wire UUID for an existing run; distinct from a mission/task identifier.",
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/definitions/ResumeExecutionSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "turnId": {
      "maxLength": 200,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "chatId"
  ],
  "title": "ResumeChatInput",
  "type": "object"
}
