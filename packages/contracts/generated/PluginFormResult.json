{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "PluginOption": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "disabled": {
          "default": false,
          "type": "boolean"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label",
        "description",
        "disabled"
      ],
      "type": "object"
    }
  },
  "properties": {
    "errors": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "options": {
      "additionalProperties": {
        "items": {
          "$ref": "#/definitions/PluginOption"
        },
        "type": "array"
      },
      "type": "object"
    },
    "values": {
      "additionalProperties": true,
      "description": "Validated against the selected package's manifest, never used for Cairn policy.",
      "type": "object",
      "x-cairn-json-object": true
    },
    "view": {
      "default": [],
      "items": true,
      "type": "array"
    }
  },
  "required": [
    "options",
    "values",
    "errors",
    "view"
  ],
  "title": "PluginFormResult",
  "type": "object"
}
