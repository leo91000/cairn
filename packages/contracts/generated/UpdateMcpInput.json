{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "McpEnvironment": {
      "additionalProperties": {
        "maxLength": 10000,
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_]\\w*$",
        "type": "string"
      },
      "type": "object"
    },
    "McpReplacementInput": {
      "additionalProperties": false,
      "properties": {
        "allowPrivateNetwork": {
          "type": "boolean"
        },
        "args": {
          "items": {
            "maxLength": 4000,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "auth": {
          "pattern": "^(none|bearer|oauth)$",
          "type": "string"
        },
        "clientId": {
          "maxLength": 500,
          "type": "string"
        },
        "clientSecret": {
          "maxLength": 10000,
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "maxLength": 1000,
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "enabledTools": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 500,
          "type": [
            "array",
            "null"
          ]
        },
        "env": {
          "anyOf": [
            {
              "$ref": "#/definitions/McpEnvironment"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "removeEnv": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "scopes": {
          "maxLength": 2000,
          "type": "string"
        },
        "token": {
          "maxLength": 10000,
          "type": [
            "string",
            "null"
          ]
        },
        "transport": {
          "pattern": "^(http|stdio)$",
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "name",
        "transport",
        "url",
        "command",
        "args",
        "auth",
        "clientId",
        "scopes",
        "allowPrivateNetwork",
        "enabled",
        "enabledTools"
      ],
      "type": "object"
    }
  },
  "properties": {
    "connection": {
      "$ref": "#/definitions/McpReplacementInput"
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "revision": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "revision",
    "connection"
  ],
  "title": "UpdateMcpInput",
  "type": "object"
}
