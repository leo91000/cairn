{
  "chat": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "default": "00000000-0000-4000-8000-000000000001",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "projectId": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "agentId",
      "projectId"
    ],
    "additionalProperties": false
  },
  "message": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "text": {
        "default": "",
        "type": "string",
        "maxLength": 50000
      },
      "attachmentIds": {
        "default": [],
        "maxItems": 8,
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "mode": {
        "default": "queue",
        "type": "string",
        "enum": [
          "queue",
          "steer"
        ]
      },
      "provider": {
        "default": "",
        "type": "string",
        "enum": [
          "",
          "codex",
          "claude",
          "opencode"
        ]
      },
      "model": {
        "default": "",
        "type": "string",
        "maxLength": 120,
        "pattern": "^[\\w./:\\[\\]-]*$"
      },
      "reasoning": {
        "default": "",
        "type": "string",
        "maxLength": 40,
        "pattern": "^(?:[a-z][a-z0-9_-]*)?$"
      },
      "plan": {
        "default": false,
        "description": "Plan turn: the agent explores and proposes an approach without changing files, using shell network access or calling tools with external effects. Send a later message without plan to implement it. Unavailable with OpenCode.",
        "type": "boolean"
      },
      "speed": {
        "default": "",
        "type": "string",
        "maxLength": 40,
        "pattern": "^(?:[a-z][a-z0-9_-]*)?$"
      }
    },
    "required": [
      "id",
      "text",
      "attachmentIds",
      "mode",
      "provider",
      "model",
      "reasoning",
      "plan",
      "speed"
    ],
    "additionalProperties": false
  },
  "answer": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "answers": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    },
    "required": [
      "id",
      "answers"
    ],
    "additionalProperties": false
  },
  "questions": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "minItems": 1,
    "maxItems": 20,
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "secret": {
          "default": false,
          "type": "boolean"
        },
        "options": {
          "default": [],
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 2000
              },
              "description": {
                "default": "",
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "label",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "title",
        "secret",
        "options"
      ],
      "additionalProperties": false
    }
  }
}
