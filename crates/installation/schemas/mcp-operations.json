[
  {
    "name": "list_chat_artifacts",
    "description": "List all published artifact versions in a conversation, with metadata, versions, groups and URLs. Paginated; files remain private unless explicitly shared.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId"
      ]
    }
  },
  {
    "name": "read_chat_artifact",
    "description": "Download the original bytes of a conversation artifact as bounded base64 chunks, including private files. Start at offset 0, decode each data chunk and append bytes until nextOffset is null. file.digest is the SHA-256 of the complete file.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId",
        "artifactId"
      ]
    }
  },
  {
    "name": "set_chat_artifact_visibility",
    "description": "Enable or revoke a public link for one artifact version in any conversation. Only make files public when the user requests sharing. Returns visibility and publicUrl; revocation cannot remove downloaded copies.",
    "scope": "manage",
    "destructive": true,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactId": {
          "type": "string",
          "format": "uuid"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId",
        "artifactId",
        "visibility"
      ]
    }
  },
  {
    "name": "list_chat_attachments",
    "description": "List files attached to a conversation, including files not yet sent. Paginated.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId"
      ]
    }
  },
  {
    "name": "read_chat_attachment",
    "description": "Download an attachment as bounded base64 chunks. Start at offset 0, decode each data chunk and append bytes until nextOffset is null. file.digest is the SHA-256 of the complete file.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId",
        "attachmentId"
      ]
    }
  },
  {
    "name": "get_chat_backend_migration",
    "description": "Preview and track an explicit backend move or native-born disk conversion. Select chatId or runId. Reports whether conversion is needed, pending work, failure/retry details and authorized destinations; expired environments require no retained disk.",
    "scope": "read",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "chatId"
          ]
        },
        {
          "required": [
            "runId"
          ]
        }
      ]
    }
  },
  {
    "name": "migrate_chat_backend",
    "description": "Explicitly change a conversation or mission backend on an authorized node. Select chatId or runId and confirm. VM-created disks reuse the same disk and engine session across VM/native nodes without copying files. A native-created disk converts once before VM execution; a chat resumes on the next message and a mission continues automatically in a fresh session with its visible history. Running commands stop and system packages do not follow. Failed conversion retains the source. Poll get_chat_backend_migration. Native provenance, administrator approvals and live management grants remain enforced. An expired environment selects its new backend without reading deleted files; the next message creates an empty environment.",
    "scope": "manage",
    "destructive": true,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "backend": {
          "type": "string",
          "enum": [
            "native",
            "firecracker"
          ]
        },
        "confirm": {
          "type": "boolean",
          "const": true
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "requiredTags": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[A-Za-z0-9_:./-]+$"
          }
        }
      },
      "required": [
        "nodeId",
        "backend",
        "confirm"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "chatId"
          ]
        },
        {
          "required": [
            "runId"
          ]
        }
      ]
    }
  }
]
