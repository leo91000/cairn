[
  {
    "name": "list_models",
    "description": "List the models a coding agent offers on its enabled accounts: reasoning levels and, for Codex, the speeds (service tiers) each model offers with Codex's own description of their usage. Use a serviceTiers id, or \"standard\", as an agent or message speed. A tier marked limited is not confirmed by every account able to run the model; runs that ask for it prefer an account that confirms it. Before each turn attempt the run checks the tier against its Codex process model list and records a status event when the outcome changes: speed.applied is standard when the turn runs at Standard, speed.confirmed when the Codex process and the account's recent catalog both list the tier and the turn asks for it, speed.unconfirmed when it cannot be confirmed for the account and model (a model list could not be read or does not name the model exactly, or the account's catalog is unknown or older than 30 minutes).",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "opencode"
          ],
          "default": "codex"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "list_skills",
    "description": "List global .agents skills or the skills for one registered project. Each item includes usageCount: the number of delivered messages invoking its $name among the installation's last 1000 chat messages (once per message, excluding code). Sort descending by usageCount to prefer frequently used skills; counts are shared across scopes with the same name.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "read_skill",
    "description": "Read a skill's files with their sizes, modes and revision, or one file's content with path. Text is returned as utf-8, other files as base64.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "maxLength": 240
        },
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "save_skill",
    "description": "Create or update SKILL.md with validated frontmatter in .agents/skills.",
    "scope": "manage",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "maxLength": 100000
        },
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "name",
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "edit_skill_files",
    "description": "Apply file changes to a skill in one atomic save: write (utf-8 or base64 content, optional executable), delete, move or mode. Pass the revision from read_skill as base, or null to create the skill. The result needs a valid SKILL.md.",
    "scope": "manage",
    "destructive": true,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "changes": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "write",
                  "delete",
                  "move",
                  "mode"
                ]
              },
              "path": {
                "type": "string",
                "maxLength": 240
              },
              "from": {
                "type": "string",
                "maxLength": 240
              },
              "to": {
                "type": "string",
                "maxLength": 240
              },
              "content": {
                "type": "string",
                "maxLength": 120000
              },
              "encoding": {
                "type": "string",
                "enum": [
                  "utf-8",
                  "base64"
                ]
              },
              "executable": {
                "type": "boolean"
              }
            },
            "required": [
              "op"
            ],
            "additionalProperties": false
          }
        },
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "name",
        "base",
        "changes"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_chat_questions",
    "description": "List conversation questions with pagination. Returns question fields and status, never saved answers.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId"
      ]
    }
  },
  {
    "name": "answer_chat_question",
    "description": "Answer a pending questionnaire with separate selected option IDs and comment for every field. Text alone is allowed. Supply a fresh UUID answer.id; identical retries are safe. May steer or start agent work.",
    "scope": "run",
    "destructive": true,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "questionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "answer": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "answers": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "selected": {
                    "default": [],
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "comment": {
                    "default": "",
                    "type": "string",
                    "maxLength": 10000
                  }
                },
                "required": [
                  "selected",
                  "comment"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "answers"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId",
        "questionId",
        "answer"
      ]
    }
  },
  {
    "name": "withdraw_chat_question",
    "description": "Withdraw a pending questionnaire without supplying any answer or authorization. Identical retries are safe; answers being delivered cannot be withdrawn.",
    "scope": "run",
    "destructive": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "questionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "chatId",
        "questionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_chat_artifacts",
    "description": "List all published artifact versions in a conversation, with metadata, versions, groups and URLs. Paginated; files remain private unless explicitly shared.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId"
      ]
    }
  },
  {
    "name": "read_chat_artifact",
    "description": "Download the original bytes of a conversation artifact as bounded base64 chunks, including private files. Start at offset 0, decode each data chunk and append bytes until nextOffset is null. file.digest is the SHA-256 of the complete file.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId",
        "artifactId"
      ]
    }
  },
  {
    "name": "set_chat_artifact_visibility",
    "description": "Enable or revoke a public link for one artifact version in any conversation. Only make files public when the user requests sharing. Returns visibility and publicUrl; revocation cannot remove downloaded copies.",
    "scope": "manage",
    "destructive": true,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactId": {
          "type": "string",
          "format": "uuid"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId",
        "artifactId",
        "visibility"
      ]
    }
  },
  {
    "name": "list_chat_attachments",
    "description": "List files attached to a conversation, including files not yet sent. Paginated.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId"
      ]
    }
  },
  {
    "name": "read_chat_attachment",
    "description": "Download an attachment as bounded base64 chunks. Start at offset 0, decode each data chunk and append bytes until nextOffset is null. file.digest is the SHA-256 of the complete file.",
    "scope": "read",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid"
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId",
        "attachmentId"
      ]
    }
  },
  {
    "name": "upload_chat_attachment",
    "description": "Upload a file to a conversation as base64 data (up to 10 MiB decoded, subject to transport request limits). Supply a fresh UUID attachmentId; identical retries are safe. Include its ID in message.attachmentIds to send it.",
    "scope": "manage",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "data": {
          "type": "string",
          "maxLength": 13981016
        }
      },
      "additionalProperties": false,
      "required": [
        "chatId",
        "attachmentId",
        "name",
        "data"
      ]
    }
  },
  {
    "name": "get_chat_backend_migration",
    "description": "Inspect a conversation whose agent execution backend changed. Returns its current and configured backend, authorized destination nodes, pending migration and errors. Migration preserves the same chat and files and starts a fresh engine session. environmentExpired reports that the old environment was already deleted; explicit confirmation selects an empty destination environment while retaining history, uploads and published artifacts.",
    "scope": "read",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "chatId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "migrate_chat_backend",
    "description": "Explicitly migrate an existing conversation to the backend currently configured on its agent. Stops execution, publishes its original environment, copies home/workspaces/output into a fresh runtime and restores it on an authorized node. Keeps the same chat and history. Operating-system packages may need reinstalling; the next message starts a fresh engine session with preserved context. Failure retains the original environment. Returns immediately; poll get_chat_backend_migration. Requires explicit confirmation and installation management access; never grants additional native node authority. If environmentExpired is true, updates the authorized backend immediately without reading or restoring a deleted disk; the next message creates an empty environment. The chosen node is pinned for fresh admission; its placement preference remains editable. Confirmation and the same live management, destination and provenance checks still apply.",
    "scope": "manage",
    "destructive": true,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "backend": {
          "type": "string",
          "enum": [
            "native",
            "firecracker"
          ]
        },
        "confirm": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "chatId",
        "nodeId",
        "backend",
        "confirm"
      ],
      "additionalProperties": false
    }
  }
]
