{
  "agent": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "provider": {
        "default": "codex",
        "type": "string",
        "enum": [
          "codex",
          "claude"
        ]
      },
      "description": {
        "default": "",
        "type": "string",
        "maxLength": 500
      },
      "model": {
        "default": "",
        "type": "string",
        "maxLength": 100
      },
      "reasoning": {
        "default": "high",
        "type": "string",
        "maxLength": 40,
        "pattern": "^(?:[a-z][a-z0-9_-]*)?$"
      },
      "instructions": {
        "default": "",
        "type": "string",
        "maxLength": 20000
      },
      "timeoutMinutes": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 720
      },
      "access": {
        "default": {
          "nodes": [
            "00000000-0000-4000-8000-000000000002"
          ],
          "maxResources": null,
          "projects": null,
          "skills": null,
          "mcps": null,
          "mcpTools": {},
          "github": true,
          "sandbox": "yolo"
        },
        "type": "object",
        "properties": {
          "nodes": {
            "default": [
              "00000000-0000-4000-8000-000000000002"
            ],
            "anyOf": [
              {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "maxResources": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "cpu": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "memoryMiB": {
                    "type": "integer",
                    "minimum": 128,
                    "maximum": 1073741824
                  },
                  "diskMiB": {
                    "type": "integer",
                    "minimum": 128,
                    "maximum": 1099511627776
                  }
                },
                "required": [
                  "cpu",
                  "memoryMiB",
                  "diskMiB"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "projects": {
            "default": null,
            "anyOf": [
              {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "skills": {
            "default": null,
            "anyOf": [
              {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "mcps": {
            "default": null,
            "anyOf": [
              {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "mcpTools": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "additionalProperties": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "github": {
            "default": true,
            "type": "boolean"
          },
          "sandbox": {
            "default": "yolo",
            "type": "string",
            "enum": [
              "yolo",
              "workspace-write",
              "read-only"
            ]
          }
        },
        "required": [
          "nodes",
          "maxResources",
          "projects",
          "skills",
          "mcps",
          "mcpTools",
          "github",
          "sandbox"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "name",
      "provider",
      "description",
      "model",
      "reasoning",
      "instructions",
      "timeoutMinutes",
      "access"
    ],
    "additionalProperties": false
  },
  "project": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "description": {
        "default": "",
        "type": "string",
        "maxLength": 500
      },
      "sourceMode": {
        "default": "remote",
        "type": "string",
        "enum": [
          "remote",
          "local"
        ]
      },
      "baseBranch": {
        "default": "main",
        "type": "string",
        "pattern": "^[a-z0-9][\\w/.-]*$"
      }
    },
    "required": [
      "name",
      "path",
      "description",
      "sourceMode",
      "baseBranch"
    ],
    "additionalProperties": false
  },
  "task": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50000
      },
      "agentId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "projectId": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          {
            "type": "null"
          }
        ]
      },
      "skills": {
        "default": null,
        "anyOf": [
          {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "tags": {
        "default": [],
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 30
        }
      },
      "cron": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "maxLength": 100
          },
          {
            "type": "null"
          }
        ]
      },
      "timezone": {
        "default": "Europe/Paris",
        "type": "string",
        "maxLength": 100
      },
      "enabled": {
        "default": true,
        "type": "boolean"
      },
      "archived": {
        "default": false,
        "type": "boolean"
      },
      "worktree": {
        "default": true,
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "prompt",
      "agentId",
      "projectId",
      "skills",
      "tags",
      "cron",
      "timezone",
      "enabled",
      "archived",
      "worktree"
    ],
    "additionalProperties": false
  },
  "chat": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentId": {
        "default": "00000000-0000-4000-8000-000000000001",
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "projectId": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "agentId",
      "projectId"
    ],
    "additionalProperties": false
  },
  "message": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "text": {
        "default": "",
        "type": "string",
        "maxLength": 50000
      },
      "attachmentIds": {
        "default": [],
        "maxItems": 8,
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "mode": {
        "default": "queue",
        "type": "string",
        "enum": [
          "queue",
          "steer"
        ]
      },
      "provider": {
        "default": "",
        "type": "string",
        "enum": [
          "",
          "codex",
          "claude"
        ]
      },
      "model": {
        "default": "",
        "type": "string",
        "maxLength": 120,
        "pattern": "^[\\w./:\\[\\]-]*$"
      },
      "reasoning": {
        "default": "",
        "type": "string",
        "maxLength": 40,
        "pattern": "^(?:[a-z][a-z0-9_-]*)?$"
      }
    },
    "required": [
      "id",
      "text",
      "attachmentIds",
      "mode",
      "provider",
      "model",
      "reasoning"
    ],
    "additionalProperties": false
  },
  "answer": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "answers": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    },
    "required": [
      "id",
      "answers"
    ],
    "additionalProperties": false
  },
  "questions": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "minItems": 1,
    "maxItems": 20,
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "secret": {
          "default": false,
          "type": "boolean"
        },
        "options": {
          "default": [],
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 2000
              },
              "description": {
                "default": "",
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "label",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "title",
        "secret",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "mcp": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "transport": {
        "default": "http",
        "type": "string",
        "enum": [
          "http",
          "stdio"
        ]
      },
      "url": {
        "default": "",
        "type": "string",
        "maxLength": 2000
      },
      "command": {
        "default": "",
        "type": "string",
        "maxLength": 1000
      },
      "args": {
        "default": [],
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "auth": {
        "default": "none",
        "type": "string",
        "enum": [
          "none",
          "bearer",
          "oauth"
        ]
      },
      "clientId": {
        "default": "",
        "type": "string",
        "maxLength": 500
      },
      "scopes": {
        "default": "",
        "type": "string",
        "maxLength": 2000
      },
      "allowPrivateNetwork": {
        "default": false,
        "type": "boolean"
      },
      "enabled": {
        "default": true,
        "type": "boolean"
      },
      "enabledTools": {
        "default": null,
        "anyOf": [
          {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "token": {
        "type": "string",
        "maxLength": 10000
      },
      "clientSecret": {
        "type": "string",
        "maxLength": 10000
      },
      "removeEnv": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "env": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[A-Z_]\\w*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "required": [
      "name",
      "transport",
      "url",
      "command",
      "args",
      "auth",
      "clientId",
      "scopes",
      "allowPrivateNetwork",
      "enabled",
      "enabledTools"
    ],
    "additionalProperties": false
  }
}
