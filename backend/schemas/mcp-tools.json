        },
        "connection": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "transport": {
              "default": "http",
              "type": "string",
              "enum": [
                "http",
                "stdio"
              ]
            },
            "url": {
              "default": "",
              "type": "string",
              "maxLength": 2000
            },
            "command": {
              "default": "",
              "type": "string",
              "maxLength": 1000
            },
            "args": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "auth": {
              "default": "none",
              "type": "string",
              "enum": [
                "none",
                "bearer",
                "oauth"
              ]
            },
            "clientId": {
              "default": "",
              "type": "string",
              "maxLength": 500
            },
            "scopes": {
              "default": "",
              "type": "string",
              "maxLength": 2000
            },
            "allowPrivateNetwork": {
              "default": false,
              "type": "boolean"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "enabledTools": {
              "default": null,
              "anyOf": [
                {
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "token": {
              "type": "string",
              "maxLength": 10000
            },
            "clientSecret": {
              "type": "string",
              "maxLength": 10000
            },
            "removeEnv": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Z_]\\w*$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 10000
              }
            }
          },
          "required": [
            "name",
            "transport",
            "url",
            "command",
            "args",
            "auth",
            "clientId",
            "scopes",
            "allowPrivateNetwork",
            "enabled",
            "enabledTools"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "connection"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "test_mcp",
    "description": "Connect to an MCP server and discover its tools. Command servers execute in the manager environment; only test trusted commands. OAuth requiring user consent must first be connected in the MCPs UI. Returns connection state and safe diagnostics.",
