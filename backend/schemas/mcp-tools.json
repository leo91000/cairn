  {
    "name": "create_mcp",
    "description": "Add an HTTP or command MCP connection. Supports bearer tokens, OAuth and command environment credentials, stored encrypted and never returned. Does not connect or execute commands. For OAuth, open managementUrl and choose Connect in the signed-in browser. Use test_mcp to discover tools, then update_agent to grant access.",
    "scope": "manage",
    "destructive": false,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "transport": {
          "default": "http",
          "type": "string",
          "enum": [
            "http",
            "stdio"
          ]
        },
        "url": {
          "default": "",
          "type": "string",
          "maxLength": 2000
        },
        "command": {
          "default": "",
          "type": "string",
          "maxLength": 1000
        },
        "args": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "auth": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "bearer",
            "oauth"
          ]
        },
        "clientId": {
          "default": "",
          "type": "string",
          "maxLength": 500
        },
        "scopes": {
          "default": "",
          "type": "string",
          "maxLength": 2000
        },
        "allowPrivateNetwork": {
          "default": false,
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "enabledTools": {
          "default": null,
          "anyOf": [
            {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "type": "string",
          "maxLength": 10000
        },
        "clientSecret": {
          "type": "string",
          "maxLength": 10000
        },
        "removeEnv": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z_]\\w*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 10000
          }
        }
      },
      "required": [
        "name",
        "transport",
        "url",
        "command",
        "args",
        "auth",
        "clientId",
        "scopes",
        "allowPrivateNetwork",
        "enabled",
        "enabledTools"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "update_mcp",
    "description": "Replace an existing MCP connection configuration; supply its complete non-secret settings. Omit token, clientSecret and env values to preserve saved credentials; removeEnv deletes selected variables. Changing authentication settings clears previous credentials. Invalidates active remote grants. OAuth sign-in is completed from managementUrl in the browser.",
