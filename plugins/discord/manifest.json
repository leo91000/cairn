{
  "id": "discord",
  "name": "Discord",
  "version": "0.2.0",
  "description": "Mention a bot in your server to start a conversation with one of your agents.",
  "apiVersion": 1,
  "capabilities": ["transport.discord", "conversations.submit", "http", "storage"],
  "hosts": ["discord.com"],
  "credential": { "label": "Bot token", "header": "authorization", "prefix": "Bot " },
  "settings": [
    { "key": "guildId", "title": "Server ID", "type": "string", "required": true, "maxLength": 20 },
    { "key": "guildName", "title": "Server name", "type": "string", "hidden": true },
    { "key": "channelId", "title": "Channel ID", "type": "string", "required": true, "maxLength": 20 },
    { "key": "channelName", "title": "Channel name", "type": "string", "hidden": true },
    { "key": "botId", "title": "Bot ID", "type": "string", "hidden": true, "maxLength": 20 },
    { "key": "botName", "title": "Bot name", "type": "string", "hidden": true }
  ]
}
