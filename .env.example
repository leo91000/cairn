# Public HTTPS origin on a VPS, localhost for local Compose.
PUBLIC_URL=http://localhost:4310
# Parallel runs and VM slots; any positive integer.
CONCURRENCY=4
LEO_IMAGE=ghcr.io/leo91000/leo-agent-manager:latest
# For development outside Docker only:
# DATA_DIR=.data
# AGENT_HOME=/home/you
# WORKSPACE_ROOTS=/home/you/projects
# Setup token is generated in DATA_DIR/setup-token; do not commit it.

# Official Claude Code CLI (subscription login is managed by the CLI).
CLAUDE_BIN=claude

# Conversation disk synchronization; credentials stay server-side.
STORAGE_S3_BUCKET=
# Example OVHcloud Paris endpoint: https://s3.eu-west-par.io.cloud.ovh.net
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
AWS_DEFAULT_REGION=
