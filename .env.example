# Optional private manager origin for execution nodes and run-scoped MCP.
PUBLIC_URL=http://localhost:4310
# Parallel runs and VM slots; any positive integer.
CONCURRENCY=4
LEO_IMAGE=ghcr.io/leo91000/leo-agent-manager:latest
# For development outside Docker only:
# DATA_DIR=.data
# AGENT_HOME=/home/you
# WORKSPACE_ROOTS=/home/you/projects
# Official service: deploy separately, then run docker compose exec manager leo claim.
LEO_OFFICIAL_ORIGIN=
# Optional one-time claim code from the official app; remove after success.
LEO_INSTALLATION_CLAIM_CODE=
LEO_INSTALLATION_NAME=My installation

# Official Claude Code CLI (subscription login is managed by the CLI).
CLAUDE_BIN=claude

# Conversation disk synchronization; credentials stay server-side.
STORAGE_S3_BUCKET=
# Example OVHcloud Paris endpoint: https://s3.eu-west-par.io.cloud.ovh.net
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
AWS_DEFAULT_REGION=
