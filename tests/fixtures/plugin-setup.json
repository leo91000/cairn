{
  "derivation": [
    {
      "name": "OAuth asks for its client settings before the sign-in",
      "manifest": {
        "id": "mail",
        "name": "Mail",
        "version": "1",
        "apiVersion": 2,
        "capabilities": [
          "http"
        ],
        "hosts": [
          "auth.mail.example"
        ],
        "credential": {
          "label": "Authorization",
          "header": "authorization",
          "oauth": {
            "authorizationUrl": "https://auth.mail.example/authorize",
            "tokenUrl": "https://auth.mail.example/token",
            "clientIdSetting": "clientId",
            "authorizationParameters": {},
            "scopeSettings": {}
          }
        },
        "settings": [
          {
            "key": "clientId",
            "title": "Client ID",
            "type": "string",
            "required": true
          },
          {
            "key": "email",
            "title": "Email",
            "type": "string",
            "hidden": true
          }
        ],
        "agentAccess": {}
      },
      "effort": "app",
      "steps": [
        {
          "id": "settings",
          "kind": "settings",
          "title": "Settings",
          "settings": [
            "clientId"
          ]
        },
        {
          "id": "credential",
          "kind": "credential",
          "title": "Sign in with Mail"
        },
        {
          "id": "agents",
          "kind": "agents",
          "title": "Agents"
        }
      ]
    },
    {
      "name": "A pasted token comes first so the form can offer its choices",
      "manifest": {
        "id": "bot",
        "name": "Bot",
        "version": "1",
        "apiVersion": 2,
        "capabilities": [
          "http",
          "conversations.submit"
        ],
        "hosts": [
          "api.bot.example"
        ],
        "credential": {
          "label": "Bot token",
          "header": "authorization"
        },
        "settings": [
          {
            "key": "channel",
            "title": "Channel",
            "type": "string"
          }
        ]
      },
      "effort": "token",
      "steps": [
        {
          "id": "credential",
          "kind": "credential",
          "title": "Bot token"
        },
        {
          "id": "settings",
          "kind": "settings",
          "title": "Settings",
          "settings": [
            "channel"
          ]
        },
        {
          "id": "people",
          "kind": "people",
          "title": "Who can talk to it"
        }
      ]
    },
    {
      "name": "A device sign-in needs nothing before it",
      "manifest": {
        "id": "forge",
        "name": "Forge",
        "version": "1",
        "apiVersion": 2,
        "capabilities": [
          "http"
        ],
        "hosts": [
          "forge.example"
        ],
        "credential": {
          "label": "Forge token",
          "header": "authorization",
          "deviceFlow": {
            "authorizationUrl": "https://forge.example/device",
            "tokenUrl": "https://forge.example/token",
            "clientId": "public"
          }
        },
        "settings": [
          {
            "key": "login",
            "title": "Login",
            "type": "string",
            "hidden": true
          }
        ],
        "agentAccess": {}
      },
      "effort": "signin",
      "steps": [
        {
          "id": "credential",
          "kind": "credential",
          "title": "Sign in with Forge"
        },
        {
          "id": "agents",
          "kind": "agents",
          "title": "Agents"
        }
      ]
    },
    {
      "name": "A required secret setting reads as a token",
      "manifest": {
        "id": "vault",
        "name": "Vault",
        "version": "1",
        "apiVersion": 2,
        "capabilities": [],
        "settings": [
          {
            "key": "token",
            "title": "Token",
            "type": "secret",
            "required": true
          }
        ],
        "agentAccess": {}
      },
      "effort": "token",
      "steps": [
        {
          "id": "settings",
          "kind": "settings",
          "title": "Settings",
          "settings": [
            "token"
          ]
        },
        {
          "id": "agents",
          "kind": "agents",
          "title": "Agents"
        }
      ]
    },
    {
      "name": "Nothing to enter means nothing to announce",
      "manifest": {
        "id": "clock",
        "name": "Clock",
        "version": "1",
        "apiVersion": 2,
        "capabilities": [
          "timers"
        ]
      },
      "effort": null,
      "steps": []
    }
  ],
  "presets": {
    "step": {
      "id": "permissions",
      "kind": "settings",
      "title": "Permissions",
      "settings": [
        "allowSend",
        "allowDrafts",
        "allowDelete"
      ],
      "presets": [
        {
          "id": "read",
          "title": "Read only"
        },
        {
          "id": "send",
          "title": "Read, draft and send",
          "values": {
            "allowDrafts": true,
            "allowSend": true
          }
        }
      ]
    },
    "fields": [
      {
        "key": "allowSend",
        "title": "Send",
        "type": "boolean"
      },
      {
        "key": "allowDrafts",
        "title": "Drafts",
        "type": "boolean"
      },
      {
        "key": "allowDelete",
        "title": "Delete",
        "type": "boolean",
        "risk": "high"
      }
    ],
    "cases": [
      {
        "values": {},
        "matching": "read"
      },
      {
        "values": {
          "allowSend": false,
          "allowDrafts": false,
          "allowDelete": false
        },
        "matching": "read"
      },
      {
        "values": {
          "allowSend": true,
          "allowDrafts": true
        },
        "matching": "send"
      },
      {
        "values": {
          "allowSend": true,
          "allowDrafts": true,
          "allowDelete": true
        },
        "matching": ""
      },
      {
        "values": {
          "allowSend": true
        },
        "matching": ""
      }
    ],
    "applied": {
      "send": {
        "allowSend": true,
        "allowDrafts": true,
        "allowDelete": false
      },
      "read": {
        "allowSend": false,
        "allowDrafts": false,
        "allowDelete": false
      }
    }
  },
  "sources": {
    "steps": [
      {
        "id": "app",
        "kind": "settings",
        "title": "App",
        "settings": [
          "clientId",
          "clientSecret"
        ],
        "shared": true
      },
      {
        "id": "connect",
        "kind": "credential",
        "title": "Sign in"
      }
    ],
    "fields": [
      {
        "key": "clientId",
        "title": "Client ID",
        "type": "string",
        "required": true
      },
      {
        "key": "clientSecret",
        "title": "Client secret",
        "type": "secret",
        "required": true
      }
    ],
    "connections": [
      {
        "id": "a",
        "name": "alice@example.test",
        "settings": {
          "clientId": "one"
        },
        "secretKeys": [
          "clientSecret"
        ],
        "status": {
          "state": "disconnected",
          "message": null
        },
        "usage": {
          "hour": 0
