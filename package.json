{
  "name": "leo-agent-manager",
  "type": "module",
  "version": "0.52.3",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "description": "A private control room for your coding agents, scheduled work, and shared skills.",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "concurrently -k 'cargo run --bin leo' 'vite --host 127.0.0.1'",
    "build": "vue-tsc --noEmit && vite build",
    "start": "target/release/leo",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm test && pnpm build",
    "format": "pnpm lint:fix",
    "format:rust": "node scripts/rust-format.mjs",
    "format:android": "cd android && ./gradlew spotlessApply --no-daemon",
    "lint:android": "cd android && ./gradlew spotlessCheck --no-daemon",
    "lint": "eslint . && node scripts/rust-format.mjs --check",
    "lint:fix": "eslint . --fix && node scripts/rust-format.mjs",
    "build:backend": "cargo build --release --bin leo",
    "test:backend": "node scripts/test-backend.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "marked": "18.0.12",
    "pdfjs-dist": "6.3.289",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.45.3",
    "@egoist/tailwindcss-icons": "1.9.2",
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@iconify-json/lucide": "1.2.130",
    "@iconify-json/simple-icons": "1.2.95",
    "@iconify-json/tabler": "1.2.38",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/hashes": "2.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "10.0.5",
    "cron-parser": "5.10.0",
    "eslint": "10.10.0",
    "fastify": "5.12.3",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11",
    "web-push": "3.6.7",
    "yaml": "2.9.0"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs",
    "preserveUnused": true
  }
}
