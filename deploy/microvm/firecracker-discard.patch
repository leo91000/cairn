+    #[test]
+    fn test_async_discard_orders_writes_and_preserves_completions() {
+        use std::os::unix::fs::FileExt;
+        let file = TempFile::new().unwrap().into_file();
+        file.set_len(16384).unwrap();
+        let witness = file.try_clone().unwrap();
+        let mem = create_mem();
+        witness.write_all_at(&[0x5a; 16384], 0).unwrap();
+        mem.write_slice(&[0x7a; 8192], GuestAddress(0)).unwrap();
+        let mut engine = FileEngine::from_file(file, FileEngineType::Async).unwrap();
+        assert!(matches!(
+            engine.write(0, &mem, GuestAddress(0), 8192, PendingRequest::default()),
+            Ok(FileEngineOk::Submitted)
+        ));
+        let error = engine
+            .discard((4096, 4096), PendingRequest::default())
+            .unwrap_err();
+        assert!(error.error.is_throttling_err());
+        engine.drain(false).unwrap();
+        assert!(
+            engine
+                .discard((4096, 4096), PendingRequest::default())
+                .unwrap_err()
+                .error
+                .is_throttling_err()
+        );
+        let FileEngine::Async(ref mut async_engine) = engine else {
+            unreachable!()
+        };
+        assert!(
+            async_engine.pop(&mem).unwrap().is_some(),
+            "discard lost earlier write completion"
+        );
+        assert!(async_engine.pop(&mem).unwrap().is_none());
+        assert!(matches!(
+            engine.discard((4096, 4096), PendingRequest::default()),
+            Ok(FileEngineOk::Submitted)
+        ));
+        assert!(
+            engine
+                .read(0, &mem, GuestAddress(0), 4096, PendingRequest::default())
+                .unwrap_err()
+                .error
+                .is_throttling_err()
+        );
+        assert!(
+            engine
+                .update_file_path(TempFile::new().unwrap().into_file())
+                .unwrap_err()
+                .is_throttling_err()
+        );
+        let blocked = engine
+            .write(4096, &mem, GuestAddress(0), 4096, PendingRequest::default())
+            .unwrap_err();
+        assert!(blocked.error.is_throttling_err());
+        engine.drain(false).unwrap();
+        // Completion alone must not permit overtaking its unconsumed receipt.
+        assert!(
+            engine
+                .flush(PendingRequest::default())
+                .unwrap_err()
+                .error
+                .is_throttling_err()
+        );
+        let FileEngine::Async(ref mut async_engine) = engine else {
+            unreachable!()
+        };
