+    pub fn push_discard(
+        &mut self,
+        range: (u64, u32),
+        req: PendingRequest,
+    ) -> Result<(), RequestError<AsyncIoError>> {
+        // Defer until earlier CQEs have been consumed. Once submitted, keep
+        // later requests behind this ordering boundary, including on failure.
+        if self.ring.num_ops() != 0 || self.discard_pending {
+            return Err(RequestError {
+                req,
+                error: AsyncIoError::DiscardBusy,
+            });
+        }
+        // Mode 3 is accepted by the VFS for both files and block devices.
+        // Block devices issue WRITE_ZEROES, supported by Cairn's ublk backend.
+        self.ring
+            .push(Operation::fallocate(
+                0,
+                u32::try_from(libc::FALLOC_FL_PUNCH_HOLE | libc::FALLOC_FL_KEEP_SIZE).unwrap(),
+                range.0,
+                range.1,
+                WrappedRequest::new(req),
+            ))
+            .map_err(|(error, data)| RequestError {
+                req: data.req,
+                error: AsyncIoError::IoUring(error),
+            })?;
+        self.discard_pending = true;
+        Ok(())
     }
 
