+    #[test]
+    fn test_discard_range_shared_memfd_reclaims_only_selected_pages() {
+        let page_size = host_page_size();
+        let regions = [
+            (GuestAddress(0), 3 * page_size),
+            (GuestAddress(0x100000), 3 * page_size),
+        ];
+        let mem = into_region_ext(memfd_backed(&regions, false, HugePageConfig::None).unwrap());
+        let second = mem.iter().nth(1).unwrap();
+        let backing = second.file_offset().unwrap().file();
+        assert_eq!(
+            second.file_offset().unwrap().start(),
+            (3 * page_size) as u64
+        );
+        let mirror = into_region_ext(
+            create(
+                regions.into_iter(),
+                libc::MAP_SHARED,
+                Some(backing.try_clone().unwrap()),
+                false,
+                0,
+            )
+            .unwrap(),
+        );
+
+        for (address, len) in regions {
+            mem.write(&vec![37u8; len], address).unwrap();
+        }
+        let allocated = backing.metadata().unwrap();
+        assert!(allocated.blocks() >= (6 * page_size / 512) as u64);
+
+        // This low-level method must not punch outside this region into its neighbours.
+        for (offset, len) in [
+            (page_size + 1, page_size),
+            (page_size, page_size + 1),
+            (2 * page_size, 2 * page_size),
+        ] {
+            assert!(
+                second
+                    .discard_range(MemoryRegionAddress(offset as u64), len)
+                    .is_err()
+            );
+        }
+        assert_eq!(backing.metadata().unwrap().blocks(), allocated.blocks());
+
+        second
+            .discard_range(MemoryRegionAddress(page_size as u64), page_size)
+            .unwrap();
+        let reclaimed = backing.metadata().unwrap();
+        assert_eq!(reclaimed.len(), allocated.len());
+        assert_eq!(
+            reclaimed.blocks(),
+            allocated.blocks() - (page_size / 512) as u64
+        );
+
+        for mapping in [&mem, &mirror] {
+            for (region_address, _) in regions {
+                for page in 0..3 {
+                    let address = region_address.unchecked_add((page * page_size) as u64);
+                    let mut actual = vec![0u8; page_size];
+                    mapping.read(&mut actual, address).unwrap();
+                    let expected = if region_address == regions[1].0 && page == 1 {
+                        0
+                    } else {
+                        37
+                    };
+                    assert_eq!(actual, vec![expected; page_size]);
+                }
+            }
+        }
+    }
